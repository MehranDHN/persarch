# GraphDB repository configuration template
# Import this from Workbench: Setup → Repositories → Create → From file
# (or paste the settings below manually).
#
# Ruleset is RDFS-Plus, not OWL-Horst:
# full Erlangen CRM OWL restrictions + owl:sameAs to Wikidata will
# over-infer and slow a case-study repo.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rep:     <http://www.openrdf.org/config/repository#> .
@prefix sr:      <http://www.openrdf.org/config/repository/sail#> .
@prefix sail:    <http://www.openrdf.org/config/sail#> .
@prefix graphdb: <http://www.ontotext.com/config/graphdb#> .

[] a rep:Repository ;
    rep:repositoryID "jame-isfahan" ;
    rdfs:label "Jameh Mosque of Isfahan — CRM + BOT case study" ;
    rep:repositoryImpl [
        rep:repositoryType "graphdb:SailRepository" ;
        sr:sailImpl [
            sail:sailType "graphdb:Sail" ;
            graphdb:ruleset "rdfsplus-optimized" ;
            graphdb:disable-sameAs "true" ;
            graphdb:enable-context-index "true" ;
            graphdb:enablePredicateList "true" ;
            graphdb:enable-literal-index "true" ;
            graphdb:in-memory-literal-properties "true" ;
            graphdb:base-URL "https://example.org/jame-isfahan/" ;
            graphdb:defaultNS "https://example.org/jame-isfahan/" ;
            graphdb:repository-type "file-repository" ;
            graphdb:storage-folder "storage"
        ]
    ] .
