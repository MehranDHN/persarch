    crm:P82a_begin_of_the_begin "1088"^^xsd:gYear ;
    crm:P82b_end_of_the_end "1089"^^xsd:gYear .

jame:ts_seljuq_iwans a crm:E52_Time-Span ;
    rdfs:label "early 12th century CE (four-iwan conversion)"@en ;
    crm:P82a_begin_of_the_begin "1100"^^xsd:gYear ;
    crm:P82b_end_of_the_end "1125"^^xsd:gYear .

jame:ts_1310 a crm:E52_Time-Span ;
    rdfs:label "710 AH / 1310 CE"@en ;
    crm:P82_at_some_time_within "1310"^^xsd:gYear .

jame:ts_ilkhanid_arcade a crm:E52_Time-Span ;
    rdfs:label "Ilkhanid reign of Öljaitü, early 14th c."@en ;
    crm:P82a_begin_of_the_begin "1304"^^xsd:gYear ;
    crm:P82b_end_of_the_end "1317"^^xsd:gYear .

jame:ts_1447 a crm:E52_Time-Span ;
    rdfs:label "851 AH / 1447 CE"@en ;
    crm:P82_at_some_time_within "1447"^^xsd:gYear .

jame:ts_1475 a crm:E52_Time-Span ;
    rdfs:label "1475–1476 CE"@en ;
    crm:P82a_begin_of_the_begin "1475"^^xsd:gYear ;
    crm:P82b_end_of_the_end "1476"^^xsd:gYear .

