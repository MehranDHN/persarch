# Instance graph — Masjed-e Jāmeʿ-e Eṣfahān
# Named graph: https://example.org/jame-isfahan/graph/data

@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix geo:   <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix crm:   <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmba: <http://www.cidoc-crm.org/extensions/crmba/> .
@prefix bot:   <https://w3id.org/bot#> .
@prefix wd:    <http://www.wikidata.org/entity/> .
@prefix jame:  <https://example.org/jame-isfahan/> .

# ----- Places -----

jame:place_isfahan a crm:E53_Place ;
    rdfs:label "Isfahan"@en ;
    rdfs:label "اصفهان"@fa ;
    skos:exactMatch wd:Q16556 ;
    geo:lat "32.66972"^^xsd:float ;
    geo:long "51.68528"^^xsd:float .

jame:place_mosque_site a crm:E53_Place ;
    rdfs:label "Site of Masjed-e Jāmeʿ-e Eṣfahān"@en ;
    crm:P89_falls_within jame:place_isfahan ;
    geo:lat "32.66972"^^xsd:float ;
    geo:long "51.68528"^^xsd:float .

# ----- Actors -----

jame:actor_nizam_al_mulk a crm:E21_Person ;
    rdfs:label "Niẓām al-Mulk"@en ;
    rdfs:label "نظام‌الملک"@fa ;
    skos:exactMatch wd:Q298427 ;
    crm:P131_is_identified_by jame:app_nizam .

jame:app_nizam a crm:E41_Appellation ;
    rdfs:label "Abū ʿAlī Ḥasan ibn ʿAlī Ṭūsī, Niẓām al-Mulk"@en .

jame:actor_taj_al_mulk a crm:E21_Person ;
    rdfs:label "Tāj al-Mulk"@en ;
    rdfs:label "تاج‌الملک"@fa ;
    crm:P3_has_note "Seljuq vizier; patron of the north dome, 1088."@en .

jame:actor_malik_shah a crm:E21_Person ;
    rdfs:label "Malik-Shāh I"@en ;
    skos:exactMatch wd:Q298448 .

jame:actor_oljeitu a crm:E21_Person ;
    rdfs:label "Öljaitü (Uljāytū)"@en ;
    rdfs:label "اولجایتو"@fa ;
    skos:exactMatch wd:Q298439 .

jame:actor_muhammad_savi a crm:E21_Person ;
    rdfs:label "Moḥammad Sāvi (Saʿd al-Dīn Muḥammad Mustawfī Sāvajī)"@en ;
    rdfs:label "محمد ساوی"@fa ;
    crm:P3_has_note "Ilkhanid vizier; patron of the 710/1310 stucco mihrab."@en .

jame:actor_badr a crm:E21_Person ;
    rdfs:label "Badr"@en ;
    rdfs:label "بدر"@fa ;
    crm:P3_has_note "Calligrapher-designer named on the Öljeitü mihrab."@en .

jame:actor_sultan_muhammad_bahadur a crm:E21_Person ;
    rdfs:label "Sulṭān Muḥammad Bahādur"@en ;
    crm:P3_has_note "Grandson of Shāhrukh; named in the 851/1447 hall inscription."@en .

jame:actor_uzun_hasan a crm:E21_Person ;
    rdfs:label "Uzun Ḥasan"@en ;
    rdfs:label "اوزون حسن"@fa ;
    skos:exactMatch wd:Q298407 .

jame:group_seljuq_masons a crm:E74_Group ;
    rdfs:label "Seljuq brick masons of the Isfahan Jāmeʿ campaigns"@en ;
    crm:P2_has_type jame:role_workshop .

jame:group_safavid_tile_workshop a crm:E74_Group ;
    rdfs:label "Safavid tile workshop active on the Jāmeʿ courtyard façades"@en ;
    crm:P2_has_type jame:role_workshop .

